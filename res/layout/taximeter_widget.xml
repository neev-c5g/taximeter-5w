<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meter_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#ff17212a">
    <TextView android:id="@+id/meter_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="운행 대기" android:textColor="#ff80cbc4" android:textSize="14sp" />
    <ImageView android:id="@+id/meter_horse" android:layout_width="match_parent" android:layout_height="110dp" android:visibility="gone" android:contentDescription="달리는 말" />
    <TextView android:id="@+id/meter_fare" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="— 원" android:textColor="#fff5f8fa"
        android:textSize="44sp" android:singleLine="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/meter_distance" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="거리\n— km" android:textColor="#ffd4dfe3" android:textSize="14sp" />
        <TextView android:id="@+id/meter_elapsed" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="운행\n—:—" android:textColor="#ffd4dfe3" android:textSize="14sp" />
        <TextView android:id="@+id/meter_slow" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="저속\n—:—" android:textColor="#ffd4dfe3" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:id="@+id/meter_breakdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="기본 · 추가 —" android:textColor="#ffd4dfe3" android:textSize="12sp" />
    <TextView android:id="@+id/meter_warning" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="차량 신호 확인 필요" android:textColor="#ffffca80" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <Button android:id="@+id/meter_toggle" android:layout_width="0dp" android:layout_weight="2" android:layout_height="match_parent" android:text="운행 시작" />
        <Button android:id="@+id/meter_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="앱 열기" />
        <Button android:id="@+id/meter_outside" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:text="시계외 끔" />
    </LinearLayout>
</LinearLayout>
